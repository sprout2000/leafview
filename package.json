{
  "name": "leafview",
  "productName": "LeafView",
  "desktopName": "LeafView",
  "description": "Minimalist image viewer based on Leaflet.js and Electron",
  "version": "4.5.3",
  "license": "MIT",
  "author": {
    "name": "sprout2000",
    "email": "wassabie64@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sprout2000/leafview.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "rimraf dist && run-p dev:webpack dev:electron",
    "dev:webpack": "cross-env NODE_ENV=\"development\" webpack --progress",
    "dev:electron": "wait-on ./dist/index.html ./dist/main.js && electronmon .",
    "build": "cross-env NODE_ENV=\"production\" webpack --progress",
    "package": "electron-builder --config.mac.identity=null",
    "lint": "biome check --write ."
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "i18next": "^26.7.2",
    "leaflet": "^1.9.4",
    "mime-types": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/leaflet": "^1.9.22",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electronmon": "^2.0.4",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.4",
    "sass": "^1.108.1",
    "sass-loader": "^17.1.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  }
}
